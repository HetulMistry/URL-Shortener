# =========================================================
# UNIVERSAL .gitignore
# Safe defaults for most languages, frameworks, editors,
# operating systems, cloud tools, and build systems.
# =========================================================


# =========================================================
# OPERATING SYSTEM FILES
# =========================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# Temporary OS files
.fseventsd


# =========================================================
# EDITORS / IDES
# =========================================================

# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# JetBrains
.idea/
*.iml

# Sublime
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*.swn

# Emacs
*~

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Eclipse
.project
.classpath
.settings/

# NetBeans
nbproject/private/
build/
nbbuild/
dist/

# Xcode
DerivedData/
*.xcworkspace
xcuserdata/
*.xcuserstate


# =========================================================
# LOGS & DEBUG
# =========================================================

*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

*.pid
*.seed
*.pid.lock

coverage/
*.lcov

# Crash dumps
*.stackdump


# =========================================================
# ENVIRONMENT & SECRETS
# =========================================================

.env
.env.*
*.env
*.local
*.secret
*.secrets
!.env.example
!.envrc.example
!.secrets.example
!.env.*.example

# Common secret files
secrets.yml
credentials.json
firebase-adminsdk*.json

# Python secrets
instance/
.webassets-cache

# Direnv
.envrc


# =========================================================
# PACKAGE MANAGERS
# =========================================================

# Node
node_modules/
.pnpm-store/
.npm/
.yarn/
.yarn-cache/
.yarnrc
.yarn-integrity

# Bun
.bun/

# Python
pip-wheel-metadata/

# PHP / Composer
vendor/

# Ruby
.bundle/

# Rust
target/

# Go
pkg/


