# =========================================================
# MISC
# =========================================================

# Local config
local.settings.json

# Runtime files
pids/
*.pid

# Temporary folders
tmp/
temp/

# Generated files
generated/

# Mac package files
*.pkg

# Misc binaries
*.bin


# =========================================================
# OPTIONAL
# =========================================================

# Images
# *.png
# *.jpg
# *.jpeg
# *.gif
# *.svg

# PDFs
# *.pdf

# Data exports
# *.csv
# *.tsv

# Lock files (usually SHOULD be committed)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# IDE settings you WANT shared
# !.vscode/settings.json
# !.idea/codeStyles/

# Ignore any file starting with "ignore."
ignore.*

# =========================================================
# END
# =========================================================