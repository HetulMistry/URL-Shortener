# Copy to .env.production before `npm run build`

# Same-origin deploy (Nginx proxies /api → backend):
VITE_API_URL=/api/v1
VITE_APP_URL=https://yourdomain.com

# Separate API host deploy (Vercel frontend + Railway/Render backend):
# VITE_API_URL=https://api.yourdomain.com/api/v1
# VITE_APP_URL=https://api.yourdomain.com
