# ─── Development (local) ───────────────────────────────────────────────────────
# API calls use /api/v1 via Vite proxy in dev — VITE_API_URL is ignored until build.

# Backend origin for the Vite dev proxy
VITE_DEV_PROXY_TARGET=http://localhost:3000

# Optional: Vite dev server port (default 5173)
# VITE_DEV_PORT=5173

# Short-link base URL shown in the dashboard (backend redirect host)
VITE_DEV_APP_URL=http://localhost:3000

# ─── Production (set in hosting provider or .env.production) ───────────────────
# VITE_API_URL=/api/v1
# VITE_APP_URL=https://yourdomain.com
