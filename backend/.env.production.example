# Copy to .env.production or set in your hosting provider

NODE_ENV=production
PORT=3000

DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# Use a cryptographically random string — minimum 32 characters in production
JWT_SECRET=<generate_a_secure_random_string_at_least_32_chars>

UPSTASH_REDIS_REST_URL=https://<your-upstash-endpoint>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your_upstash_rest_token>

# Your deployed frontend URL(s), comma-separated
ALLOWED_ORIGINS=https://yourdomain.com

# Public URL for short links — must match VITE_APP_URL on the frontend
APP_BASE_URL=https://yourdomain.com

LOG_LEVEL=info
